<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ingresos" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30"
              whenNoDataType="AllSectionsNoDetail">

    <style name="base" isDefault="true" fontName="SansSerif" fontSize="10" pdfFontName="Helvetica" pdfEncoding="Cp1252"/>

    <parameter name="titulo" class="java.lang.String"/>
    <parameter name="rango" class="java.lang.String"/>
    <parameter name="generado" class="java.lang.String"/>

    <field name="concepto" class="java.lang.String"/>
    <field name="cantidad" class="java.lang.Integer"/>
    <field name="total" class="java.math.BigDecimal"/>

    <variable name="SUMA" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{total}]]></variableExpression>
    </variable>
    <variable name="CANT" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{cantidad}]]></variableExpression>
    </variable>

    <title>
        <band height="62">
            <textField>
                <reportElement x="0" y="0" width="535" height="26" forecolor="#1F4A42"/>
                <textElement><font size="18" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{titulo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="28" width="535" height="14"/>
                <textFieldExpression><![CDATA[$P{rango}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="43" width="535" height="14" forecolor="#666666"/>
                <textFieldExpression><![CDATA[$P{generado}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText><reportElement mode="Opaque" x="0" y="0" width="235" height="22" forecolor="#FFFFFF" backcolor="#2F6F62"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[ Concepto]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="235" y="0" width="120" height="22" forecolor="#FFFFFF" backcolor="#2F6F62"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Pagos ]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="355" y="0" width="180" height="22" forecolor="#FFFFFF" backcolor="#2F6F62"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Total ]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22">
            <textField><reportElement x="0" y="0" width="235" height="22"/>
                <textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[" " + $F{concepto}]]></textFieldExpression></textField>
            <textField><reportElement x="235" y="0" width="120" height="22"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{cantidad} + " "]]></textFieldExpression></textField>
            <textField><reportElement x="355" y="0" width="180" height="22"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[new java.text.DecimalFormat("'Q'#,##0.00").format($F{total}) + " "]]></textFieldExpression></textField>
            <line><reportElement x="0" y="21" width="535" height="1" forecolor="#DDDDDD"/></line>
        </band>
    </detail>

    <summary>
        <band height="34">
            <staticText><reportElement x="0" y="8" width="235" height="20"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[ Total de ingresos]]></text></staticText>
            <textField><reportElement x="235" y="8" width="120" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[($V{CANT} == null ? 0 : $V{CANT}) + " "]]></textFieldExpression></textField>
            <textField><reportElement x="355" y="8" width="180" height="20" forecolor="#1F4A42"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[new java.text.DecimalFormat("'Q'#,##0.00").format($V{SUMA} == null ? java.math.BigDecimal.ZERO : $V{SUMA}) + " "]]></textFieldExpression></textField>
        </band>
    </summary>
</jasperReport>
