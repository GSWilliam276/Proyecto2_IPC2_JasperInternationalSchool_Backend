<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="rendimiento" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30"
              whenNoDataType="AllSectionsNoDetail">

    <style name="base" isDefault="true" fontName="SansSerif" fontSize="10" pdfFontName="Helvetica" pdfEncoding="Cp1252"/>

    <parameter name="titulo" class="java.lang.String"/>
    <parameter name="seccion" class="java.lang.String"/>
    <parameter name="generado" class="java.lang.String"/>

    <field name="bloque" class="java.lang.String"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="detalle" class="java.lang.String"/>
    <field name="promedio" class="java.math.BigDecimal"/>

    <group name="bloque">
        <groupExpression><![CDATA[$F{bloque}]]></groupExpression>
        <groupHeader>
            <band height="30">
                <textField><reportElement x="0" y="8" width="535" height="18" forecolor="#1F4A42"/>
                    <textElement><font size="12" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                    <textFieldExpression><![CDATA[$F{bloque}]]></textFieldExpression></textField>
            </band>
        </groupHeader>
    </group>

    <title>
        <band height="64">
            <textField><reportElement x="0" y="0" width="470" height="30" forecolor="#1F4A42"/>
                <textElement><font size="22" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <textFieldExpression><![CDATA[$P{titulo}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="32" width="470" height="14"/>
                <textElement><font isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <textFieldExpression><![CDATA[$P{seccion}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="47" width="470" height="14" forecolor="#666666"/>
                <textFieldExpression><![CDATA[$P{generado}]]></textFieldExpression></textField>
            <image>
                <reportElement x="485" y="10" width="50" height="50"/>
                <imageExpression><![CDATA["reportes/logo.png"]]></imageExpression>
            </image>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText><reportElement mode="Opaque" x="0" y="0" width="250" height="22" forecolor="#FFFFFF" backcolor="#2F6F62"/>
                <textElement verticalAlignment="Middle"><font isBold="true" pdfFontName="Helvetica-Bold"/></textElement><text><![CDATA[ Nombre]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="250" y="0" width="185" height="22" forecolor="#FFFFFF" backcolor="#2F6F62"/>
                <textElement verticalAlignment="Middle"><font isBold="true" pdfFontName="Helvetica-Bold"/></textElement><text><![CDATA[ Detalle]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="435" y="0" width="100" height="22" forecolor="#FFFFFF" backcolor="#2F6F62"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true" pdfFontName="Helvetica-Bold"/></textElement><text><![CDATA[Promedio ]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField isStretchWithOverflow="true"><reportElement x="0" y="0" width="250" height="20"/>
                <textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[" " + $F{nombre}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement x="250" y="0" width="185" height="20"/>
                <textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[" " + $F{detalle}]]></textFieldExpression></textField>
            <textField><reportElement x="435" y="0" width="100" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[new java.text.DecimalFormat("0.00").format($F{promedio}) + " "]]></textFieldExpression></textField>
            <line><reportElement x="0" y="19" width="535" height="1" forecolor="#DDDDDD"/></line>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField><reportElement x="335" y="4" width="200" height="14" forecolor="#666666"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
        </band>
    </pageFooter>
</jasperReport>