<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="prestamos_mora" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30"
              whenNoDataType="AllSectionsNoDetail">

    <style name="base" isDefault="true" fontName="SansSerif" fontSize="9" pdfFontName="Helvetica" pdfEncoding="Cp1252"/>

    <parameter name="titulo" class="java.lang.String"/>
    <parameter name="rango" class="java.lang.String"/>
    <parameter name="generado" class="java.lang.String"/>

    <field name="libro" class="java.lang.String"/>
    <field name="prestatario" class="java.lang.String"/>
    <field name="tipo" class="java.lang.String"/>
    <field name="fechaPrestamo" class="java.lang.String"/>
    <field name="fechaEsperada" class="java.lang.String"/>
    <field name="diasAtraso" class="java.lang.Integer"/>
    <field name="recargo" class="java.math.BigDecimal"/>

    <variable name="TOTAL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{recargo}]]></variableExpression>
    </variable>

    <title>
        <band height="62">
            <textField>
                <reportElement x="0" y="0" width="782" height="26" forecolor="#1F4A42"/>
                <textElement><font size="18" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{titulo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="28" width="782" height="14"/>
                <textFieldExpression><![CDATA[$P{rango}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="43" width="782" height="14" forecolor="#666666"/>
                <textFieldExpression><![CDATA[$P{generado}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText><reportElement mode="Opaque" x="0" y="0" width="200" height="22" forecolor="#FFFFFF" backcolor="#2F6F62"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[ Libro]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="200" y="0" width="200" height="22" forecolor="#FFFFFF" backcolor="#2F6F62"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[ Prestatario]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="400" y="0" width="80" height="22" forecolor="#FFFFFF" backcolor="#2F6F62"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[ Tipo]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="480" y="0" width="80" height="22" forecolor="#FFFFFF" backcolor="#2F6F62"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[ Préstamo]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="560" y="0" width="80" height="22" forecolor="#FFFFFF" backcolor="#2F6F62"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[ Esperada]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="640" y="0" width="50" height="22" forecolor="#FFFFFF" backcolor="#2F6F62"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Días ]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="690" y="0" width="92" height="22" forecolor="#FFFFFF" backcolor="#2F6F62"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Recargo ]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField isStretchWithOverflow="true"><reportElement x="0" y="0" width="200" height="20"/>
                <textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[" " + $F{libro}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement x="200" y="0" width="200" height="20"/>
                <textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[" " + $F{prestatario}]]></textFieldExpression></textField>
            <textField><reportElement x="400" y="0" width="80" height="20"/>
                <textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[" " + $F{tipo}]]></textFieldExpression></textField>
            <textField><reportElement x="480" y="0" width="80" height="20"/>
                <textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[" " + $F{fechaPrestamo}]]></textFieldExpression></textField>
            <textField><reportElement x="560" y="0" width="80" height="20"/>
                <textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[" " + $F{fechaEsperada}]]></textFieldExpression></textField>
                        <textField><reportElement x="640" y="0" width="50" height="20"/>
            <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{diasAtraso} == null ? "N/A " : $F{diasAtraso} + " "]]></textFieldExpression></textField>
            <textField><reportElement x="690" y="0" width="86" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{recargo} == null ? "N/A " : new java.text.DecimalFormat("'Q'#,##0.00").format($F{recargo}) + " "]]></textFieldExpression></textField>
            <line><reportElement x="0" y="19" width="782" height="1" forecolor="#DDDDDD"/></line>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="582" y="4" width="200" height="14" forecolor="#666666"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="34">
            <staticText><reportElement x="490" y="8" width="200" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Total de recargos:]]></text></staticText>
            <textField pattern="'Q'#,##0.00">
                <reportElement x="690" y="8" width="92" height="20" forecolor="#1F4A42"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{TOTAL} == null ? java.math.BigDecimal.ZERO : $V{TOTAL}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>